# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Groq LLM (free tier — 14,400 req/day) ────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ── Gmail SMTP (App Password — NOT your Gmail password) ───────────────────────
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=EAAxxxxxx
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ── n8n Webhooks (optional — fill after n8n is running) ──────────────────────
N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/lead-notification
